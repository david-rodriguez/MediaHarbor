# Non-secret host settings. Run ./harbor init to copy this file to config/host.env.
PUID=1000
PGID=1000
TZ=America/New_York
APPDATA_ROOT=/srv/mediaharbor/appdata
DATA_ROOT=/srv/mediaharbor/data
PROTON_COUNTRIES=Netherlands
# Comma-separated optional services. Remove the ones you do not want.
COMPOSE_PROFILES=tautulli,recyclarr,unpackerr,flaresolverr,jellyfin,lidarr,sabnzbd,bookshelf,audiobookshelf,homepage
# Homepage: use the server's full MagicDNS name.
HOMEPAGE_ALLOWED_HOSTS=localhost:3000
HOMEPAGE_VAR_BASE_URL=https://mediaharbor.example-tailnet.ts.net
# Portainer stacks only: the host folder of this clone.
# HARBOR_ROOT=/opt/mediaharbor
